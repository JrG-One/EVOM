# ─── EVOM Backend Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values

PORT=5001
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5434/interviewwhiz?schema=public"
JWT_SECRET="your_jwt_secret"

# ─── Cloudinary (Image/File Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── AI Chat Completion (OpenAI or Azure OpenAI) ─────────────────
# For OpenAI Direct:
OPENAI_API_KEY="your_openai_api_key"
OPENAI_API_URL="https://api.openai.com/v1/chat/completions"

# For Azure OpenAI (uncomment and set):
# OPENAI_API_KEY="your_azure_api_key"
# OPENAI_API_URL="https://your-resource.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2024-02-15-preview"

# ─── RAG Embedding Model ─────────────────────────────────────────
# Provider: "openai" (default) or "azure"
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"

# For OpenAI Direct embeddings (uses OPENAI_API_KEY above):
# OPENAI_EMBEDDING_URL is optional — defaults to https://api.openai.com/v1/embeddings

# For Azure OpenAI embeddings (uncomment and set):
# EMBEDDING_PROVIDER="azure"
# AZURE_EMBEDDING_API_URL="https://your-resource.openai.azure.com/openai/deployments/text-embedding-ada-002/embeddings?api-version=2024-02-15-preview"
# AZURE_EMBEDDING_API_KEY="your_azure_embedding_key"

# ─── RAG Configuration ───────────────────────────────────────────
RAG_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=5

# ─── Email Service ───────────────────────────────────────────────
EMAIL_SERVICE="smtp.gmail.com"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_app_password"

# ─── Code Runner Microservice ────────────────────────────────────
CODE_RUNNER_URL="http://localhost:5002"
SERVICE_SECRET="default_secret_change_me"

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY="your_resend_key"
