generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id         String   @id @default(uuid())
  username   String
  email      String   @unique
  password   String
  profilePic String?  @default("")
  role       Role     @default(USER)
  isAdmin    Boolean  @default(false) // Deprecated: keep for migration compatibility
  isVerified Boolean  @default(false)
  resumeUrl  String?
  atsScore   Int      @default(0)
  
  // Profile Fields
  bio         String?
  phone       String?
  location    String?
  socialLinks String?  // Stored as JSON string
  experience  Json?    // Stored as JSON array
  education   Json?    // Stored as JSON array

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  interviews Interview[]
  tokens     VerificationToken[]
  logs       AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
}


model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Interview {
  id                String   @id @default(uuid())
  company           String
  role              String
  experience        String
  preferredLanguage String
  codingRound       Boolean  @default(false)
  pdfReport         String?  @default("No File")
  score             Float    @default(0)
  createdAt         DateTime @default(now())
  
  // Storing questions as JSON to be flexible with structure
  questions         Json?    

  userId            String
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId]) // Added index for faster history fetching
}

model Resource {
  id          String @id @default(uuid())
  title       String
  description String
  thumbnail   String
  link        String
}
