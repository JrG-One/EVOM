generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CreditPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum CreditChangeType {
  INIT
  CONSUME
  ADJUST
  RESET
  TOPUP
}

model User {
  id         String   @id @default(uuid())
  username   String
  email      String   @unique
  password   String
  profilePic String?  @default("")
  role       Role     @default(USER)
  isAdmin    Boolean  @default(false) // Deprecated: keep for migration compatibility
  isVerified Boolean  @default(false)
  resumeUrl  String?
  atsScore   Int      @default(0)
  
  // Profile Fields
  bio         String?
  phone       String?
  location    String?
  socialLinks String?  // Stored as JSON string
  experience  Json?    // Stored as JSON array
  education   Json?    // Stored as JSON array

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  status     UserStatus @default(ACTIVE)
  
  interviews Interview[]
  tokens     VerificationToken[]
  logs       AuditLog[]
  featureFlags FeatureFlag[] @relation("FeatureFlagUpdatedBy")
  activityLogs UserActivityLog[]
  aiCreditQuota AICreditQuota?
  aiCreditLedger AICreditLedger[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedById String?
  updatedBy   User?    @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model UserActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  meta      Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model AICreditQuota {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         CreditPlan @default(FREE)
  monthlyLimit Int        @default(1000)
  usedThisCycle Int       @default(0)
  cycleStart   DateTime   @default(now())
  cycleEnd     DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([plan])
  @@index([cycleEnd])
}

model AICreditLedger {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeType   CreditChangeType
  delta        Int
  balanceAfter Int
  source       String?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([changeType, createdAt])
}

model DailyAdminMetric {
  id                  String   @id @default(uuid())
  date                DateTime @unique
  activeUsers         Int      @default(0)
  interviewsStarted   Int      @default(0)
  interviewsCompleted Int      @default(0)
  creditsConsumed     Int      @default(0)
  failedEvents        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Interview {
  id                String   @id @default(uuid())
  company           String
  role              String
  experience        String
  preferredLanguage String
  codingRound       Boolean  @default(false)
  pdfReport         String?  @default("No File")
  score             Float    @default(0)
  createdAt         DateTime @default(now())
  
  // Storing questions as JSON to be flexible with structure
  questions         Json?    
  
  // Storing the array of conversation messages
  chatHistory       Json?    @default("[]")

  userId            String
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId]) // Added index for faster history fetching
}

model Resource {
  id          String @id @default(uuid())
  title       String
  description String
  thumbnail   String
  link        String
}

// ─── RAG Knowledge Base ───────────────────────────────────────────

model KnowledgeDocument {
  id        String   @id @default(uuid())
  title     String
  source    String   @default("curated") // curated, scraped, user_contributed
  category  String   // interview_question, rubric, competency_framework, company_pattern
  company   String?  // nullable — applies to all companies if null
  role      String?  // nullable — applies to all roles if null
  difficulty String? // easy, medium, hard, expert
  tags      String[] // e.g., ["dsa", "arrays", "google", "behavioral"]
  metadata  Json?    // flexible extra data
  checksum  String?  @unique // SHA-256 hash for deduplication

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks    KnowledgeChunk[]

  @@index([category])
  @@index([company])
  @@index([role])
}

model KnowledgeChunk {
  id          String   @id @default(uuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     String   // The actual text content of this chunk
  chunkIndex  Int      // Order within the parent document
  tokenCount  Int      @default(0)
  metadata    Json?    // flexible extra data (topic, subtopic, etc.)
  // NOTE: 'embedding' vector(1536) column is added via raw SQL migration

  createdAt   DateTime @default(now())

  @@index([documentId])
}
