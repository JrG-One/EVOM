# Postgres Database Environment Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=interviewwhiz

# Backend Application Configuration
PORT=5001
NODE_ENV=production

# Database URL for Prisma / Backend
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:secure_password_here@postgres:5432/interviewwhiz?schema=public"

# Authentication Secrets
JWT_SECRET="generate_a_secure_jwt_secret_here"

# Cloudinary (Image/Asset Hosting)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OpenAI / Azure OpenAI (AI Model APIs)
OPENAI_API_KEY="your_openai_key"
OPENAI_API_URL="your_openai_endpoint"

# Email Service Config
EMAIL_SERVICE="gmail"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_app_password"

# Internal Microservices
CODE_RUNNER_URL="http://coderunner:5000"
SERVICE_SECRET="generate_a_secure_service_secret_here"
